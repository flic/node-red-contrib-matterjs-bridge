{
  "name": "@frtnbach/node-red-contrib-matterjs-bridge",
  "version": "0.8.5",
  "description": "Node-RED bridge between matterjs-server (Matter-over-IP controller) and Node-RED flows. Built on the official @matter-server/ws-client.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flic/node-red-contrib-matterjs-bridge.git"
  },
  "keywords": [
    "node-red",
    "matter",
    "matterjs-server",
    "home-automation",
    "iot"
  ],
  "author": "Fredrik Furtenbach",
  "license": "ISC",
  "scripts": {
    "postpublish": "node --env-file=.env scripts/bsky-announce.js",
    "test:announce": "node --env-file=.env scripts/bsky-announce.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "matterjsController": "core/controller.js",
      "matterjsIn": "core/in.js",
      "matterjsOut": "core/out.js",
      "matterjsDiscover": "core/discover.js"
    }
  },
  "dependencies": {
    "@atproto/api": "^0.20.34",
    "@matter-server/ws-client": "^1.0.0"
  }
}

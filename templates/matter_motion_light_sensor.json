  "functions": {
    "ingress": [
      { "name": "Matter occupancy bit → bool", "fn": "const v = Number(msg.payload);\nif (!isFinite(v)) return null;\nreturn (v & 1) === 1;" },
      { "name": "Matter illuminance → lux", "fn": "const v = Number(msg.payload);\nif (!isFinite(v)) return null;\nreturn Math.round(Math.pow(10, (v - 1) / 10000));" },
      { "name": "Matter halfpercent → percent", "fn": "const v = Number(msg.payload);\nif (!isFinite(v)) return null;\nreturn Math.round(v / 2);" },
      { "name": "Pass-through", "fn": "return msg.payload;" }
    ],

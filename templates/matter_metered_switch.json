    {
      "name": "Current",
      "id": "mms_current",
      "endpoint": 0,
      "cluster": 144,
      "attr": 5,
      "haType": "",
      "ingress": "Matter milli → unit",
      "readOnly": true,
      "notes": "ElectricalPowerMeasurement.ActiveCurrent on root endpoint, mA."

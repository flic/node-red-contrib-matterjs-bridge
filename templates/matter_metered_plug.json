{
  "id": "matter_metered_plug_thingtype",
  "name": "Matter Metered Plug",
  "shape": "(1,266),(2,1296)",
  "nodestatus": "🔌 %On% ⚡ %Power%W",
  "items": [
    {
      "name": "On",
      "id": "mmp_on",
      "endpoint": 1,
      "cluster": 6,
      "attr": 0,
      "haType": "switch",
      "ingress": "Pass-through",
      "egress": "Matter OnOff"
    },
    {
      "name": "Power",
      "id": "mmp_power",
      "endpoint": 2,
      "cluster": 144,
      "attr": 8,
      "haType": "power",
      "ingress": "Matter milli → unit",
      "readOnly": true,
      "notes": "ElectricalPowerMeasurement.ActivePower, mW."
    },
    {
      "name": "Voltage",
      "id": "mmp_voltage",
      "endpoint": 2,
      "cluster": 144,
      "attr": 4,
      "haType": "",
      "ingress": "Matter milli → unit",
      "readOnly": true,
      "history": false,
      "notes": "ElectricalPowerMeasurement.Voltage, mV."
    },
    {
      "name": "Current",
      "id": "mmp_current",
      "endpoint": 2,
      "cluster": 144,
      "attr": 5,
      "haType": "",
      "ingress": "Matter milli → unit",
      "readOnly": true,
      "notes": "ElectricalPowerMeasurement.ActiveCurrent, mA."
    }
  ],
  "functions": {
    "ingress": [
      { "name": "Pass-through", "fn": "return msg.payload;" },
      { "name": "Matter milli → unit", "fn": "const v = Number(msg.payload);\nif (!isFinite(v)) return null;\nreturn Math.round(v / 10) / 100;" }
    ],
    "egress": [
      { "name": "Matter OnOff", "fn": "const tm = String(msg.topic || '').match(/^matter\\/(\\d+)\\/(\\d+)/);\nif (!tm) return null;\nmsg.payload = {\n    nodeId: Number(tm[1]),\n    endpoint: Number(tm[2]),\n    cluster: 6,\n    command: msg.payload ? 'On' : 'Off'\n};\nreturn msg;" }
    ]
  }
}

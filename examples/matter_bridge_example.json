[
  {
    "id": "tab_matter_bridge_demo",
    "type": "tab",
    "label": "Matter Bridge Demo",
    "disabled": false,
    "info": "Demoflow för nodered-contrib-matterjs-bridge.\n\n1. Importera detta flow.\n2. Editera matterController-noden: kontrollera att WS URL pekar mot din matterjs-server.\n3. Deploy. matterController ska visa 'connected'.\n4. matterIn → debug visar attribute-uppdateringar.\n5. Tryck en inject för att skicka command, eller trigga Discover för att generera flow-snippet.\n"
  },
  {
    "id": "matter_ctrl_demo",
    "type": "matterController",
    "name": "matter (demo)",
    "url": "${MATTER_WS_URL}",
    "templatesDir": "",
    "polls": []
  },
  {
    "id": "demo_in",
    "type": "matterIn",
    "z": "tab_matter_bridge_demo",
    "name": "all matter events",
    "controller": "matter_ctrl_demo",
    "format": "hal2",
    "topicFilter": "",
    "nodeIdFilter": "",
    "x": 240,
    "y": 100,
    "wires": [["demo_in_dbg"]]
  },
  {
    "id": "demo_in_dbg",
    "type": "debug",
    "z": "tab_matter_bridge_demo",
    "name": "events",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "true",
    "targetType": "full",
    "x": 470,
    "y": 100,
    "wires": []
  },
  {
    "id": "demo_inject_on",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Test: nodeId 29 ON",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "{\"kind\":\"device_command\",\"nodeId\":29,\"endpoint\":1,\"cluster\":6,\"command\":\"On\"}",
    "payloadType": "json",
    "x": 200,
    "y": 200,
    "wires": [["demo_out"]]
  },
  {
    "id": "demo_inject_off",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Test: nodeId 29 OFF",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "{\"kind\":\"device_command\",\"nodeId\":29,\"endpoint\":1,\"cluster\":6,\"command\":\"Off\"}",
    "payloadType": "json",
    "x": 200,
    "y": 240,
    "wires": [["demo_out"]]
  },
  {
    "id": "demo_out",
    "type": "matterOut",
    "z": "tab_matter_bridge_demo",
    "name": "send command",
    "controller": "matter_ctrl_demo",
    "x": 430,
    "y": 220,
    "wires": [["demo_out_dbg"]]
  },
  {
    "id": "demo_out_dbg",
    "type": "debug",
    "z": "tab_matter_bridge_demo",
    "name": "cmd result",
    "active": true,
    "complete": "payload",
    "x": 620,
    "y": 220,
    "wires": []
  },
  {
    "id": "demo_inject_discover",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Discover all",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "go",
    "payloadType": "str",
    "x": 170,
    "y": 320,
    "wires": [["demo_discover"]]
  },
  {
    "id": "demo_discover",
    "type": "matterDiscover",
    "z": "tab_matter_bridge_demo",
    "name": "discover",
    "controller": "matter_ctrl_demo",
    "format": "hal2",
    "eventHandlerId": "",
    "filter": "",
    "x": 360,
    "y": 320,
    "wires": [["demo_discover_dbg"]]
  },
  {
    "id": "demo_discover_dbg",
    "type": "debug",
    "z": "tab_matter_bridge_demo",
    "name": "flow-snippet",
    "active": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 560,
    "y": 320,
    "wires": []
  }
]

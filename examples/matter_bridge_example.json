[
  {
    "id": "tab_matter_bridge_demo",
    "type": "tab",
    "label": "Matter Bridge Demo",
    "disabled": false,
    "info": "Demo flow for node-red-contrib-matterjs-bridge.\n\n1. Import this flow.\n2. Edit the matterjs controller node: check that the WS URL points to your matterjs-server.\n3. Deploy. The controller should report 'connected'.\n4. matterjs in → debug shows attribute updates flowing in.\n5. Press an On/Off inject to send a command (defaults to nodeId 29 — change to one you have).\n6. Try the Discover injects to see the three output formats. Use 'hal2' to generate importable Things, 'summary' for a quick inventory, 'node' for full raw data when developing a new device template.\n"
  },
  {
    "id": "matter_ctrl_demo",
    "type": "matterjsController",
    "name": "matterjs (demo)",
    "url": "${MATTER_WS_URL}",
    "templatesDir": "",
    "polls": []
  },
  {
    "id": "demo_in",
    "type": "matterjsIn",
    "z": "tab_matter_bridge_demo",
    "name": "all matter events",
    "controller": "matter_ctrl_demo",
    "format": "hal2",
    "topicFilter": "",
    "nodeIdFilter": "",
    "x": 240,
    "y": 100,
    "wires": [["demo_in_dbg"]]
  },
  {
    "id": "demo_in_dbg",
    "type": "debug",
    "z": "tab_matter_bridge_demo",
    "name": "events",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "true",
    "targetType": "full",
    "x": 470,
    "y": 100,
    "wires": []
  },
  {
    "id": "demo_inject_on",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Test: nodeId 29 ON",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "{\"kind\":\"device_command\",\"nodeId\":29,\"endpoint\":1,\"cluster\":6,\"command\":\"On\"}",
    "payloadType": "json",
    "x": 200,
    "y": 200,
    "wires": [["demo_out"]]
  },
  {
    "id": "demo_inject_off",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Test: nodeId 29 OFF",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "{\"kind\":\"device_command\",\"nodeId\":29,\"endpoint\":1,\"cluster\":6,\"command\":\"Off\"}",
    "payloadType": "json",
    "x": 200,
    "y": 240,
    "wires": [["demo_out"]]
  },
  {
    "id": "demo_out",
    "type": "matterjsOut",
    "z": "tab_matter_bridge_demo",
    "name": "send command",
    "controller": "matter_ctrl_demo",
    "x": 430,
    "y": 220,
    "wires": [["demo_out_dbg"]]
  },
  {
    "id": "demo_out_dbg",
    "type": "debug",
    "z": "tab_matter_bridge_demo",
    "name": "cmd result",
    "active": true,
    "complete": "payload",
    "x": 620,
    "y": 220,
    "wires": []
  },
  {
    "id": "demo_discover_comment",
    "type": "comment",
    "z": "tab_matter_bridge_demo",
    "name": "Discover — five injects feed the same node; format/filter are msg-overridden per invocation",
    "info": "Discover output formats:\n\n• hal2     — importable Node-RED flow snippet. Copy the array from debug, Ctrl+I → Clipboard → Import.\n• summary  — lightweight per-node metadata for inventory / dashboards.\n• node     — full raw node data (incl. attributes map). Use when developing a new device template.\n\nMatter node id filter:\n\n• blank        — all commissioned nodes\n• numeric (e.g. 29) — single node\n• 'last'       — most recently commissioned node (by date_commissioned)\n",
    "x": 360,
    "y": 320,
    "wires": []
  },
  {
    "id": "demo_inject_disc_all",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Discover all (hal2 snippet)",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "go",
    "payloadType": "str",
    "x": 170,
    "y": 360,
    "wires": [["demo_discover"]]
  },
  {
    "id": "demo_inject_disc_one",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Discover one (msg.payload=29)",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "29",
    "payloadType": "num",
    "x": 180,
    "y": 400,
    "wires": [["demo_discover"]]
  },
  {
    "id": "demo_inject_disc_last",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Discover last commissioned",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "last",
    "payloadType": "str",
    "x": 170,
    "y": 440,
    "wires": [["demo_discover"]]
  },
  {
    "id": "demo_inject_disc_summary",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Discover summary (all)",
    "props": [
      { "p": "format", "v": "summary", "vt": "str" },
      { "p": "payload", "v": "go", "vt": "str" }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "",
    "payloadType": "str",
    "x": 160,
    "y": 480,
    "wires": [["demo_discover"]]
  },
  {
    "id": "demo_inject_disc_node",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Discover raw node data (last)",
    "props": [
      { "p": "format", "v": "node", "vt": "str" },
      { "p": "nodeId", "v": "last", "vt": "str" }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "",
    "payloadType": "str",
    "x": 180,
    "y": 520,
    "wires": [["demo_discover"]]
  },
  {
    "id": "demo_discover",
    "type": "matterjsDiscover",
    "z": "tab_matter_bridge_demo",
    "name": "discover",
    "controller": "matter_ctrl_demo",
    "format": "hal2",
    "eventHandlerId": "",
    "filter": "",
    "x": 460,
    "y": 440,
    "wires": [["demo_discover_dbg"]]
  },
  {
    "id": "demo_discover_dbg",
    "type": "debug",
    "z": "tab_matter_bridge_demo",
    "name": "discover output",
    "active": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 660,
    "y": 440,
    "wires": []
  },
  {
    "id": "demo_catch_comment",
    "type": "comment",
    "z": "tab_matter_bridge_demo",
    "name": "Error handling — catch node fires on matterjs out / discover failures (e.g. unknown nodeId, timeout, malformed payload)",
    "info": "By default, matterjsOut and matterjsDiscover propagate failures via done(err) which Node-RED's catch node picks up. Enable the per-node 'Error output' toggle if you instead want errors routed to a second output port.\n\nFor matterjsIn (no input message) there is no triggering msg for catch — use that node's Error output toggle to surface controller-level errors like disconnect.\n",
    "x": 360,
    "y": 620,
    "wires": []
  },
  {
    "id": "demo_inject_bad_cmd",
    "type": "inject",
    "z": "tab_matter_bridge_demo",
    "name": "Trigger error: nodeId 9999 ON",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "{\"kind\":\"device_command\",\"nodeId\":9999,\"endpoint\":1,\"cluster\":6,\"command\":\"On\"}",
    "payloadType": "json",
    "x": 200,
    "y": 660,
    "wires": [["demo_out"]]
  },
  {
    "id": "demo_catch",
    "type": "catch",
    "z": "tab_matter_bridge_demo",
    "name": "catch matterjs errors",
    "scope": ["demo_out", "demo_discover"],
    "uncaught": false,
    "x": 200,
    "y": 720,
    "wires": [["demo_catch_dbg"]]
  },
  {
    "id": "demo_catch_dbg",
    "type": "debug",
    "z": "tab_matter_bridge_demo",
    "name": "caught error",
    "active": true,
    "complete": "true",
    "targetType": "full",
    "x": 430,
    "y": 720,
    "wires": []
  }
]
